{
  "name": "@gspa/ui",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "Global Security Practitioners Alliance Vue component library",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./components/*": {
      "types": "./dist/src/components/*.vue.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs"
    },
    "./layouts/*": {
      "types": "./dist/src/layouts/*.vue.d.ts",
      "import": "./dist/layouts/*.js",
      "require": "./dist/layouts/*.cjs"
    },
    "./lib/*": {
      "types": "./dist/src/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "require": "./dist/lib/*.cjs"
    },
    "./directives/*": {
      "types": "./dist/src/directives/*.d.ts",
      "import": "./dist/directives/*.js",
      "require": "./dist/directives/*.cjs"
    },
    "./utils/*": {
      "types": "./dist/src/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.cjs"
    },
    "./dist/gspa-ui.css": "./dist/gspa-ui.css",
    "./css": "./dist/gspa-ui.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:docs": "vite --config vite.docs.config.js",
    "build": "vite build && vue-tsc --build --emitDeclarationOnly --force && npm run test:bundle-size",
    "build:watch": "vite build --watch",
    "build:docs": "vite build --config vite.docs.config.js",
    "preview:docs": "vite preview --config vite.docs.config.js",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:bundle-size": "node scripts/check-bundle-size.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "tailwind",
    "component-library"
  ],
  "author": "Global Security Practitioners Alliance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/James-Kabz/gspa-ui.git"
  },
  "homepage": "https://github.com/James-Kabz/gspa-ui#readme",
  "bugs": {
    "url": "https://github.com/James-Kabz/gspa-ui/issues"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "3.3.1"
  },
  "peerDependencies": {
    "pinia": ">=3.0.4 <5",
    "vue": "^3.5.18",
    "vue-router": ">=4.6.4 <6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.1",
    "@fortawesome/free-regular-svg-icons": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "24.3.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "pinia": "^3.0.4",
    "rollup": "^4.50.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.0.7"
  }
}
